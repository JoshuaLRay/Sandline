{
  "name": "sandline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "sim-run": "tsx packages/tools/src/sim-run.ts",
    "gen:trig": "tsx packages/tools/src/gen-trig-table.ts",
    "gen:nav-spike": "tsx packages/tools/src/gen-nav-spike.ts",
    "gen:nav": "tsx packages/tools/src/gen-nav.ts",
    "gen:audio": "tsx packages/tools/src/gen-audio.ts",
    "gen:voice": "tsx packages/tools/src/gen-voice.ts",
    "bench:rapier": "tsx packages/tools/src/bench-rapier.ts",
    "bench:nav": "tsx packages/tools/src/bench-nav.ts",
    "test:parity-browsers": "vitest run --config vitest.browser.config.ts",
    "build:artifact": "pnpm --filter @sandline/client build && tsx packages/tools/src/build-artifact.ts",
    "bench:bandwidth": "tsx packages/tools/src/bench-bandwidth.ts",
    "bench:tickrate": "tsx packages/tools/src/bench-tickrate.ts",
    "host": "tsx packages/server/src/main.ts",
    "bot": "tsx packages/bot/src/main.ts",
    "gen:assets": "tsx packages/tools/src/gen-assets.ts",
    "export:soldier": "tsx packages/tools/src/export-soldier.ts",
    "check:assets": "tsx packages/tools/src/check-assets.ts",
    "gen:art": "tsx packages/tools/src/gen-art.ts",
    "bake:light": "tsx packages/tools/src/bake-light.ts",
    "check:packs": "tsx packages/tools/src/check-packs.ts",
    "check:load-time": "tsx packages/tools/src/check-load-time.ts",
    "perf:frame": "tsx packages/tools/src/perf-frame.ts"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@dimforge/rapier3d-deterministic-compat": "0.20.0",
    "@dimforge/rapier3d-simd-compat": "0.20.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.2",
    "@vitest/browser": "^3.2.7",
    "eslint": "^9.39.1",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
