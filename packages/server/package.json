    },
    "./nav/baked": {
      "types": "./src/ai/nav/bakedNav.ts",
      "default": "./src/ai/nav/bakedNav.ts"
    },
    "./brain": {
      "types": "./src/ai/Brain.ts",
      "default": "./src/ai/Brain.ts"
    }
